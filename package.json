{
	"name": "msomu.com",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build && node scripts/dedupe-talks-routes.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"check": "biome check ./src",
		"lint": "biome lint ./src",
		"format": "biome format --write .",
		"test": "node --experimental-strip-types --test tests/accept.test.ts tests/agent-identity.test.ts tests/connect-page.test.ts tests/paths-and-404.test.ts tests/talks-routes.test.ts tests/writing-routes.test.ts",
		"test:http": "node --experimental-strip-types --test tests/http.test.ts"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^14.0.0",
		"@astrojs/mdx": "^7.0.0",
		"@astrojs/rss": "^4.0.18",
		"@tailwindcss/vite": "^4.3.1",
		"astro": "^7.0.2",
		"kotlin-playground": "^1.30.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.7.2",
		"@tailwindcss/typography": "^0.5.20"
	}
}
