---
import { getCollection, render } from "astro:content";
import { ScrollProgress } from "@components/misc";
import ThinkInCodeLayout from "@layouts/think-in-code-layout.astro";

const posts = await getCollection("thinkInCode");

const { slug } = Astro.params;
const post = posts.find((page) => page.id === slug);

if (!post) {
	return Astro.rewrite(`/404?from=${encodeURIComponent(Astro.url.pathname)}`);
}

const { Content } = await render(post);
---

<ThinkInCodeLayout {...post.data}>
	<Content />
	<ScrollProgress />
</ThinkInCodeLayout>
