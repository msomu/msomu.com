---
import type { ConnectIcon } from "@data/connect";

interface Props {
	id: ConnectIcon;
	size?: number;
	class?: string;
}

const { id, size = 20, class: className } = Astro.props;

const stroke = {
	fill: "none",
	stroke: "currentColor",
	"stroke-width": 2,
	"stroke-linecap": "round",
	"stroke-linejoin": "round",
} as const;
---

<svg
	width={size}
	height={size}
	viewBox='0 0 24 24'
	aria-hidden='true'
	class={className}
	{...(id === "contact" ||
	id === "email" ||
	id === "slides" ||
	id === "megaphone" ||
	id === "rss" ||
	id === "instagram"
		? stroke
		: { fill: "currentColor" })}>
	{
		id === "contact" && (
			<>
				<path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' />
				<circle cx='9' cy='7' r='4' />
				<path d='M19 8v6M22 11h-6' />
			</>
		)
	}
	{
		id === "email" && (
			<>
				<rect x='2' y='4' width='20' height='16' rx='2' />
				<path d='m22 7-10 6L2 7' />
			</>
		)
	}
	{
		id === "slides" && (
			<>
				<rect x='2' y='3' width='20' height='14' rx='2' />
				<path d='M8 21h8M12 17v4' />
			</>
		)
	}
	{
