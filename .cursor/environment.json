{
  "name": "msomu.com",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "./.cursor/install.sh",
  "terminals": [
    {
      "name": "dev-server",
      "command": "export PATH=\"$HOME/.bun/bin:$PATH\" && bun dev --host 0.0.0.0"
    }
  ],
  "ports": [
    {
      "name": "astro-dev",
      "port": 4321
    }
  ]
}
