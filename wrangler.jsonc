{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "msomu-com",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-06-24",
	"durable_objects": {
		"bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	}
}
